# Copy this file to .env and adjust values:  copy .env.example .env   (Windows)
#                                            cp .env.example .env     (macOS/Linux)
# Never commit your real .env file.

# Bind to localhost only. Do not expose the development server to a network.
APP_HOST=127.0.0.1
APP_PORT=5000

# Never enable debug mode outside local development (it exposes an interactive debugger).
FLASK_DEBUG=false

# SQLite database location (created automatically; ignored by git).
DATABASE_PATH=instance/privacy_assessments.db

# Synthetic dataset used by the aggregate dashboard.
DATASET_PATH=data/social_media_privacy_assessments.csv

# Retention limitation: stored assessments older than this are deleted on start-up.
RETENTION_DAYS=30

# Maximum POST requests per minute per client for assessment endpoints (0 disables).
RATE_LIMIT_PER_MINUTE=30
